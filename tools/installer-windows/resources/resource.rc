#define IDI_ICON1 1
#define RT_MANIFEST 24
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1

IDI_ICON1 ICON "icon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "installer.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ZenTrack Team\0"
            VALUE "FileDescription", "ZenTrack Official Installer\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "ZenTrack-Setup.exe\0"
            VALUE "LegalCopyright", "Copyright 2026 ZenTrack\0"
            VALUE "OriginalFilename", "ZenTrack-Setup.exe\0"
            VALUE "ProductName", "ZenTrack\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
