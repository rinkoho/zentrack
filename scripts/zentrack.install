post_upgrade() {
    echo "Reiniciando instancias de zentrack-server..."
    pkill -f zentrack-server || true
}

post_install() {
    echo "=========================================================="
    echo "🚀 ZenTrack instalado correctamente."
    echo ""
    echo "Modo Normal (Para tu usuario local):"
    echo "  systemctl --user enable --now zentrack"
    echo ""
    echo "Modo Login Screen (Para usarlo en SDDM/GDM):"
    echo "  sudo systemctl enable --now zentrack-system@\$USER"
    echo "  (¡Asegúrate de desactivar el de usuario si usas este!)"
    echo "=========================================================="
}
